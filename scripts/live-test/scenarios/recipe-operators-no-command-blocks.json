{
  "name": "recipe-operators-no-command-blocks",
  "description": "Recipe: operators in the admin group cannot place, open or break command blocks.",
  "when": {"plugin": true, "backend": "luckperms", "minVersion": "1.14"},
  "server": {"properties": {"spawn-protection": 0}},
  "players": ["Bot"],
  "steps": [
    {"connect": "Bot"},
    {"op": "Bot"},
    {"console": "clear Bot"},
    {"console": "gamemode creative Bot", "expect": "game mode"},
    {"console": "forceload add 0 0", "expect": "chunk|forced|loaded"},
    {"console": "fill -3 199 -3 3 199 3 minecraft:stone", "expect": "filled|No blocks"},
    {"console": "fill -3 200 -3 3 202 3 minecraft:air", "expect": "filled|No blocks"},
    {"console": "tp Bot 0.5 200 0.5", "expect": "Teleported"},
    {"console": "setblock 1 200 1 minecraft:air"},
    {"console": "give Bot minecraft:command_block", "expect": "Gave"},
    {"name": "before: an operator places a command block", "use": {"x": 1, "y": 199, "z": 1}, "expect": {"outcome": "allowed"}},
    {"console": "execute if block 1 200 1 minecraft:command_block", "expect": "Test passed"},
    {"console": "setblock 1 200 1 minecraft:air", "expect": "Changed"},
    {"console": "lp deletegroup admin", "expect": "\\[LP\\]"},
    {"console": "lp creategroup admin", "expect": "\\[LP\\].*(created|already exists)"},
    {"console": "lp user Bot parent add admin", "expect": "\\[LP\\].*(now inherits|already)"},
    {"console": "lp group admin permission set minecraft.operator_block.command_block.* false", "expect": "\\[LP\\].*(Set|already)"},
    {"wait": 1000},
    {"name": "can't: place a command block", "use": {"x": 1, "y": 199, "z": 1}, "expect": {"outcome": "denied", "chat": "place command blocks"}},
    {"console": "execute if block 1 200 1 minecraft:command_block", "expect": "Test failed"},
    {"console": "setblock -1 200 0 minecraft:command_block", "expect": "Changed"},
    {"console": "clear Bot", "expect": "Removed"},
    {"name": "can't: open a command block", "use": {"x": -1, "y": 200, "z": 0}, "expect": {"outcome": "denied", "chat": "open command blocks"}},
    {"name": "can: other commands, /time set day", "as": "Bot", "command": "/time set day", "expect": {"outcome": "allowed"}},
    {"name": "not covered: /setblock of a command block", "as": "Bot", "command": "/setblock 1 200 1 minecraft:command_block", "expect": {"outcome": "allowed"}},
    {"console": "execute if block 1 200 1 minecraft:command_block", "expect": "Test passed"},
    {"console": "setblock 1 200 1 minecraft:air", "expect": "Changed"},
    {"console": "lp group admin permission set minecraft.command.setblock false", "expect": "\\[LP\\].*(Set|already)"},
    {"wait": 1000},
    {"name": "with setblock denied: /setblock refused", "as": "Bot", "command": "/setblock 1 200 1 minecraft:command_block", "expect": {"outcome": "denied"}},
    {"console": "setblock -1 200 0 minecraft:air", "expect": "Changed"}
  ]
}

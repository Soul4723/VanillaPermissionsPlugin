{
  "name": "aliases",
  "description": "Redirect aliases (/tp, /tell, /w) have their own root node, also through Bukkit's command dispatch (a commands.yml alias), with the target command's node as the fallback when unset. On 1.19 - 1.20.5 a typed /tell skips Bukkit's check, so an unset /tell does not fall back to msg there.",
  "when": { "plugin": true, "backend": "luckperms", "minVersion": "1.13" },
  "server": { "files": { "commands.yml": "aliases:\n  vpptp:\n  - tp $1-\n" } },
  "players": ["Bot", "Bot2"],
  "steps": [
    { "name": "spigot adapter: alias wrappers got their own Bukkit node", "log": "Gave the vanilla alias commands their own Bukkit permission node", "when": { "maxVersion": "1.20.5" } },
    { "log": "Could not give the vanilla alias commands", "absent": true },
    { "connect": "Bot" },
    { "connect": "Bot2" },
    { "perm": { "user": "Bot", "node": "minecraft.command.tp", "value": true } },
    { "name": "only minecraft.command.tp: /tp ~ ~5 ~ allowed", "as": "Bot", "command": "/tp ~ ~5 ~", "expect": { "outcome": "allowed", "teleported": true } },
    { "name": "only minecraft.command.tp: /vpptp ~ ~5 ~ (commands.yml, Bukkit dispatch) allowed", "as": "Bot", "command": "/vpptp ~ ~5 ~", "expect": { "outcome": "allowed", "teleported": true } },
    { "name": "only minecraft.command.tp: /teleport ~ ~5 ~ denied", "as": "Bot", "command": "/teleport ~ ~5 ~", "expect": { "outcome": "denied", "teleported": false } },
    { "perm": { "user": "Bot", "node": "minecraft.command.tp", "value": false } },
    { "perm": { "user": "Bot", "node": "minecraft.command.teleport", "value": true } },
    { "name": "minecraft.command.tp false beats minecraft.command.teleport: /tp ~ ~5 ~ denied", "as": "Bot", "command": "/tp ~ ~5 ~", "expect": { "outcome": "denied", "teleported": false } },
    { "perm": { "user": "Bot", "node": "minecraft.command.msg", "value": false } },
    { "perm": { "user": "Bot", "node": "minecraft.command.tell", "value": true } },
    { "name": "minecraft.command.tell true, msg false: /tell Bot2 hi allowed", "as": "Bot", "command": "/tell Bot2 hi", "expect": { "outcome": "allowed" } },
    { "perm": { "user": "Bot", "node": "minecraft.command.tell", "value": null } },
    { "name": "tell unset falls back to msg false: /tell Bot2 hi denied", "as": "Bot", "command": "/tell Bot2 hi", "expect": { "outcome": "denied" }, "when": { "not": { "minVersion": "1.19", "maxVersion": "1.20.5" } } },
    { "perm": { "user": "Bot", "node": "minecraft.command.msg", "value": null } },
    { "name": "no nodes: /w Bot2 hi allowed (vanilla default)", "as": "Bot", "command": "/w Bot2 hi", "expect": { "outcome": "allowed" } },
    { "perm": { "user": "Bot", "node": "minecraft.command.w", "value": false } },
    { "name": "minecraft.command.w false: /w Bot2 hi denied", "as": "Bot", "command": "/w Bot2 hi", "expect": { "outcome": "denied" } }
  ]
}

{
  "name": "recipe-event-hosts",
  "description": "Recipe: event hosts use /effect and /give on others with selectors, at most 10 targets at a time.",
  "when": {"plugin": true, "backend": "luckperms", "minVersion": "1.14"},
  "server": {"properties": {"spawn-protection": 0}},
  "players": ["Bot", "Bot2"],
  "steps": [
    {"connect": "Bot"},
    {"connect": "Bot2"},
    {"console": "forceload add 0 0", "expect": "chunk|forced|loaded"},
    {"console": "fill -3 199 -3 3 199 3 minecraft:stone", "expect": "filled|No blocks"},
    {"console": "fill -3 200 -3 3 202 3 minecraft:air", "expect": "filled|No blocks"},
    {"console": "tp Bot 0.5 200 0.5", "expect": "Teleported"},
    {"console": "kill @e[tag=vpp]"},
    {"console": "summon minecraft:chicken -2 201 -2 {NoAI:1b,PersistenceRequired:1b,Tags:[\"vpp\"]}", "expect": "Summoned"},
    {"console": "summon minecraft:chicken -1 201 -2 {NoAI:1b,PersistenceRequired:1b,Tags:[\"vpp\"]}", "expect": "Summoned"},
    {"console": "summon minecraft:chicken 0 201 -2 {NoAI:1b,PersistenceRequired:1b,Tags:[\"vpp\"]}", "expect": "Summoned"},
    {"console": "summon minecraft:chicken 1 201 -2 {NoAI:1b,PersistenceRequired:1b,Tags:[\"vpp\"]}", "expect": "Summoned"},
    {"console": "summon minecraft:chicken 2 201 -2 {NoAI:1b,PersistenceRequired:1b,Tags:[\"vpp\"]}", "expect": "Summoned"},
    {"console": "summon minecraft:chicken -2 201 2 {NoAI:1b,PersistenceRequired:1b,Tags:[\"vpp\"]}", "expect": "Summoned"},
    {"console": "summon minecraft:chicken -1 201 2 {NoAI:1b,PersistenceRequired:1b,Tags:[\"vpp\"]}", "expect": "Summoned"},
    {"console": "summon minecraft:chicken 0 201 2 {NoAI:1b,PersistenceRequired:1b,Tags:[\"vpp\"]}", "expect": "Summoned"},
    {"console": "summon minecraft:chicken 1 201 2 {NoAI:1b,PersistenceRequired:1b,Tags:[\"vpp\"]}", "expect": "Summoned"},
    {"console": "summon minecraft:chicken 2 201 2 {NoAI:1b,PersistenceRequired:1b,Tags:[\"vpp\"]}", "expect": "Summoned"},
    {"console": "lp deletegroup host", "expect": "\\[LP\\]"},
    {"console": "lp creategroup host", "expect": "\\[LP\\].*(created|already exists)"},
    {"console": "lp user Bot parent add host", "expect": "\\[LP\\].*(now inherits|already)"},
    {"console": "lp group host permission set minecraft.command.effect true", "expect": "\\[LP\\].*(Set|already)"},
    {"console": "lp group host permission set minecraft.command.give true", "expect": "\\[LP\\].*(Set|already)"},
    {"console": "lp group host permission set minecraft.selector true", "expect": "\\[LP\\].*(Set|already)"},
    {"console": "lp group host meta set minecraft.selector.limit.effect.targets 10", "expect": "\\[LP\\].*(Set|already)"},
    {"console": "lp group host meta set minecraft.selector.limit.give.targets 10", "expect": "\\[LP\\].*(Set|already)"},
    {"wait": 1000},
    {"name": "can: /effect give @a speed", "as": "Bot", "command": "/effect give @a minecraft:speed 5", "expect": {"outcome": "allowed"}},
    {"name": "can: /give @a bread", "as": "Bot", "command": "/give @a minecraft:bread", "expect": {"outcome": "allowed", "chat": "Gave|give"}},
    {"name": "can: /effect give Bot2 glowing", "as": "Bot", "command": "/effect give Bot2 minecraft:glowing 5", "expect": {"outcome": "allowed"}},
    {"name": "can: 10 targets: /effect give @e[tag=vpp] glowing", "as": "Bot", "command": "/effect give @e[tag=vpp] minecraft:glowing 5", "expect": {"outcome": "allowed"}},
    {"console": "summon minecraft:chicken 3 201 0 {NoAI:1b,PersistenceRequired:1b,Tags:[\"vpp\"]}", "expect": "Summoned"},
    {"name": "can't: 11 targets: /effect give @e[tag=vpp] glowing", "as": "Bot", "command": "/effect give @e[tag=vpp] minecraft:glowing 5", "expect": {"outcome": "denied", "chat": "at most 10"}},
    {"name": "check the give key with a cap of 1", "console": "lp group host meta set minecraft.selector.limit.give.targets 1", "expect": "\\[LP\\].*(Set|already)"},
    {"wait": 1000},
    {"name": "give key caps /give: /give @a bread with 2 players", "as": "Bot", "command": "/give @a minecraft:bread", "expect": {"outcome": "denied", "chat": "at most 1"}},
    {"console": "kill @e[tag=vpp]"}
  ]
}

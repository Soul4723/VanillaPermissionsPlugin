{
  "name": "recipe-builders",
  "description": "Recipe: builders switch themselves between creative and survival, use /time, /weather and the debug stick (Paper), and still cannot place command blocks.",
  "when": {"plugin": true, "backend": "luckperms", "minVersion": "1.14"},
  "server": {"properties": {"spawn-protection": 0}},
  "players": ["Bot", "Bot2"],
  "steps": [
    {"connect": "Bot"},
    {"connect": "Bot2"},
    {"console": "clear Bot"},
    {"console": "forceload add 0 0", "expect": "chunk|forced|loaded"},
    {"console": "fill -3 199 -3 3 199 3 minecraft:stone", "expect": "filled|No blocks"},
    {"console": "fill -3 200 -3 3 202 3 minecraft:air", "expect": "filled|No blocks"},
    {"console": "tp Bot 0.5 200 0.5", "expect": "Teleported"},
    {"console": "lp deletegroup builder", "expect": "\\[LP\\]"},
    {"console": "lp creategroup builder", "expect": "\\[LP\\].*(created|already exists)"},
    {"console": "lp user Bot parent add builder", "expect": "\\[LP\\].*(now inherits|already)"},
    {"console": "lp group builder permission set minecraft.command.gamemode true", "expect": "\\[LP\\].*(Set|already)"},
    {"console": "lp group builder permission set minecraft.command.gamemode.* false", "expect": "\\[LP\\].*(Set|already)"},
    {"console": "lp group builder permission set minecraft.command.gamemode.creative true", "expect": "\\[LP\\].*(Set|already)"},
    {"console": "lp group builder permission set minecraft.command.gamemode.survival true", "expect": "\\[LP\\].*(Set|already)"},
    {"console": "lp group builder permission set minecraft.command.time true", "expect": "\\[LP\\].*(Set|already)"},
    {"console": "lp group builder permission set minecraft.command.weather true", "expect": "\\[LP\\].*(Set|already)"},
    {"console": "lp group builder permission set minecraft.debugstick true", "expect": "\\[LP\\].*(Set|already)"},
    {"wait": 1000},
    {"name": "can: /gamemode creative", "as": "Bot", "command": "/gamemode creative", "expect": {"outcome": "allowed", "gamemode": "creative"}},
    {"name": "can't: /gamemode spectator", "as": "Bot", "command": "/gamemode spectator", "expect": {"outcome": "denied", "gamemode": "creative"}},
    {"name": "can't: /gamemode creative Bot2", "as": "Bot", "command": "/gamemode creative Bot2", "expect": {"outcome": "denied"}},
    {"name": "can: /time set day", "as": "Bot", "command": "/time set day", "expect": {"outcome": "allowed", "chat": "Set the time"}},
    {"name": "can: /weather clear", "as": "Bot", "command": "/weather clear", "expect": {"outcome": "allowed"}},
    {"console": "setblock 2 200 0 minecraft:oak_stairs", "expect": "Changed|Could not"},
    {"console": "give Bot minecraft:debug_stick", "expect": "Gave"},
    {"name": "can: debug stick on oak stairs (Paper)", "use": {"x": 2, "y": 200, "z": 0}, "expect": {"outcome": "allowed", "chat": "debug_stick"}, "when": {"not": {"software": "spigot"}}},
    {"console": "clear Bot", "expect": "Removed"},
    {"console": "give Bot minecraft:command_block", "expect": "Gave"},
    {"name": "right-click the floor with a command block", "use": {"x": 1, "y": 199, "z": 1}, "expect": {"outcome": "allowed"}},
    {"console": "execute if block 1 200 1 minecraft:command_block", "expect": "Test failed"},
    {"name": "can: /gamemode survival", "as": "Bot", "command": "/gamemode survival", "expect": {"outcome": "allowed", "gamemode": "survival"}},
    {"name": "can't: /gamemode adventure", "as": "Bot", "command": "/gamemode adventure", "expect": {"outcome": "denied", "gamemode": "survival"}}
  ]
}

{
  "name": "folia",
  "description": "Folia command status, LuckPerms permission refreshes and region-safe checks.",
  "when": { "plugin": true, "backend": "luckperms", "software": "folia", "minVersion": "1.20.6" },
  "players": ["Bot", "Bot2"],
  "steps": [
    { "connect": "Bot" },
    { "connect": "Bot2" },
    { "name": "debug identifies Folia server", "console": "vanillapermissions debug", "expect": "Server: Folia " },
    { "name": "debug reports LuckPerms connected", "console": "vanillapermissions debug", "expect": "Permissions: .*LuckPerms [^ ]+ .*LuckPerms refreshes command lists on changes" },
    { "name": "debug reports selector metadata", "console": "vanillapermissions debug", "expect": "Selector limits and weights: .*LuckPerms meta" },
    { "name": "check reports Bot's default-false gamemode node", "console": "vanillapermissions check Bot minecraft.command.gamemode", "expect": "Bot: minecraft\\.command\\.gamemode = false" },
    { "name": "tree initially lacks gamemode", "tree": { "lacks": ["gamemode"] } },
    { "perm": { "node": "minecraft.command.gamemode", "value": true } },
    { "name": "user grant refreshes tree", "tree": { "has": ["gamemode"] } },
    { "perm": { "node": "minecraft.command.gamemode", "value": null } },
    { "name": "user unset refreshes tree", "tree": { "lacks": ["gamemode"] } },
    { "console": "lp creategroup vpp_folia_audit", "expect": "\\[LP\\].*(Created|already exists)" },
    { "console": "lp group vpp_folia_audit parent add default", "expect": "\\[LP\\].*(now inherits|already inherits|already has)" },
    { "console": "lp user Bot parent add vpp_folia_audit", "expect": "\\[LP\\].*(now inherits|already inherits|already has)" },
    { "console": "lp user Bot2 parent add vpp_folia_audit", "expect": "\\[LP\\].*(now inherits|already inherits|already has)" },
    { "console": "lp group vpp_folia_audit permission set minecraft.command.gamemode true", "expect": "\\[LP\\].*(Set|already)" },
    { "name": "group grant refreshes Bot tree", "tree": { "has": ["gamemode"] }, "as": "Bot" },
    { "name": "group grant refreshes Bot2 tree", "tree": { "has": ["gamemode"] }, "as": "Bot2" },
    { "name": "group grant allows Bot", "as": "Bot", "command": "/gamemode creative", "expect": { "outcome": "allowed", "gamemode": "creative" } },
    { "name": "check reports Bot2's inherited true node", "console": "vanillapermissions check Bot2 minecraft.command.gamemode", "expect": "Bot2: minecraft\\.command\\.gamemode = true" },
    { "console": "lp group vpp_folia_audit permission set minecraft.command.gamemode false", "expect": "\\[LP\\].*(Set|already)" },
    { "name": "group denial refreshes Bot tree", "tree": { "lacks": ["gamemode"] }, "as": "Bot" },
    { "name": "group denial refreshes Bot2 tree", "tree": { "lacks": ["gamemode"] }, "as": "Bot2" },
    { "name": "group denial denies Bot", "as": "Bot", "command": "/gamemode survival", "expect": { "outcome": "denied", "gamemode": "creative" } },
    { "name": "check reports Bot2's inherited false node", "console": "vanillapermissions check Bot2 minecraft.command.gamemode", "expect": "Bot2: minecraft\\.command\\.gamemode = false" },
    { "perm": { "user": "Bot", "node": "minecraft.command.tp", "value": true } },
    { "perm": { "user": "Bot", "node": "minecraft.selector", "value": true } },
    { "meta": { "user": "Bot", "key": "minecraft.selector.limit.teleport.targets.targets.location", "value": 1 } },
    { "name": "selector limit denies /tp @a", "as": "Bot", "command": "/tp @a ~ ~ ~", "expect": { "chat": "at most 1 player or entity", "teleported": false } },
    { "name": "no UnsupportedOperationException", "log": "UnsupportedOperationException", "absent": true },
    { "console": "lp user Bot clear", "expect": "\\[LP\\].*clear" },
    { "console": "lp user Bot2 clear", "expect": "\\[LP\\].*clear" },
    { "console": "lp deletegroup vpp_folia_audit", "expect": "\\[LP\\].*(Deleted|does not exist|not found)" }
  ]
}

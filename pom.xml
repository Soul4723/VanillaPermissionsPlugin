<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.soul4723</groupId>
    <artifactId>vanillapermissions-parent</artifactId>
    <version>1.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>VanillaPermissionsPlugin</name>
    <description>Drop-in Bukkit port of DrexHD's VanillaPermissions: granular permissions for vanilla commands, selectors and operator features, for any permissions plugin (Paper, Spigot and forks, 1.8.8 to 26.3)</description>
    <url>https://github.com/Soul4723/VanillaPermissionsPlugin</url>

    <!-- core: platform-free logic and the VersionAdapter SPI; legacy: the 1.8.8 - 1.12.2 adapter; brigadier: Brigadier tree
         patching shared by the 1.13+ adapters; spigot: the Spigot 1.13+ and Paper 1.13 - 1.20.4 adapter; paper: the modern
         Paper adapter; plugin: plugin.yml and the shaded jar. -->
    <modules>
        <module>core</module>
        <module>legacy</module>
        <module>brigadier</module>
        <module>spigot</module>
        <module>paper</module>
        <module>plugin</module>
    </modules>

    <properties>
        <!-- Every module except paper runs on Java 8 servers (core on any server the plugin may meet, brigadier shared by the
             1.13+ adapters, spigot on Java 8 up to 1.16.5, legacy on 1.8.8 - 1.12.2), so the default release is 8. The plugin
             module has no code, but maven-jar-plugin 3.5 writes its release into the shaded jar's manifest as Java-Version. -->
        <java.version>8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Fixed so rebuilding a tag gives the same jar. -->
        <project.build.outputTimestamp>2026-10-21T00:00:00Z</project.build.outputTimestamp>
        <paper.api.version>1.20.6-R0.1-SNAPSHOT</paper.api.version>
        <!-- The oldest API core compiles against; newer API belongs in a version adapter. -->
        <spigot.api.version>1.8.8-R0.1-SNAPSHOT</spigot.api.version>
        <!-- The brigadier module compiles against the oldest Brigadier server API (1.13.2) and Brigadier 1.0.17. Not managed
             below: paper-api brings a newer Brigadier, which a managed version would replace in the paper module. -->
        <spigot.brigadier.api.version>1.13.2-R0.1-SNAPSHOT</spigot.brigadier.api.version>
        <brigadier.version>1.0.17</brigadier.version>
        <junit.version>6.1.3</junit.version>
    </properties>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:git://github.com/Soul4723/VanillaPermissionsPlugin.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/Soul4723/VanillaPermissionsPlugin.git</developerConnection>
        <url>https://github.com/Soul4723/VanillaPermissionsPlugin/tree/main</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/Soul4723/VanillaPermissionsPlugin/issues</url>
    </issueManagement>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>soul4723</id>
            <name>Soul4723</name>
            <email>contact@soul4723.com</email>
        </developer>
    </developers>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>minecraft-libraries</id>
            <url>https://libraries.minecraft.net</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.soul4723</groupId>
                <artifactId>vanillapermissions-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.soul4723</groupId>
                <artifactId>vanillapermissions-core</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>io.github.soul4723</groupId>
                <artifactId>vanillapermissions-brigadier</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.soul4723</groupId>
                <artifactId>vanillapermissions-spigot</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.soul4723</groupId>
                <artifactId>vanillapermissions-paper</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.soul4723</groupId>
                <artifactId>vanillapermissions-legacy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.papermc.paper</groupId>
                <artifactId>paper-api</artifactId>
                <version>${paper.api.version}</version>
            </dependency>
            <dependency>
                <groupId>org.spigotmc</groupId>
                <artifactId>spigot-api</artifactId>
                <version>${spigot.api.version}</version>
                <exclusions>
                    <!-- json-simple 1.1.1 declares JUnit 4 as a compile dependency, which stops surefire running JUnit 5. -->
                    <exclusion>
                        <groupId>junit</groupId>
                        <artifactId>junit</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>net.luckperms</groupId>
                <artifactId>api</artifactId>
                <version>5.5</version>
            </dependency>
            <dependency>
                <groupId>com.github.MilkBowl</groupId>
                <artifactId>VaultAPI</artifactId>
                <version>1.7.1</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.bukkit</groupId>
                        <artifactId>bukkit</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>UTF-8</encoding>
                        <!-- Tests run on the build JDK and may use its syntax. -->
                        <testRelease>21</testRelease>
                        <compilerArgs>
                            <!-- JDK 21 warns that release 8 is obsolete; that is the point here. -->
                            <arg>-Xlint:-options</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                    <configuration>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                    <configuration>
                        <failIfNoTests>true</failIfNoTests>
                        <systemPropertyVariables>
                            <project.version>${project.version}</project.version>
                            <!-- Tests that read repository files (workflows, scripts) resolve them from here. -->
                            <repo.root>${project.basedir}/..</repo.root>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                    <configuration>
                        <archive>
                            <addMavenDescriptor>false</addMavenDescriptor>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
